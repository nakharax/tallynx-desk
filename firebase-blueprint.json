{
  "entities": {
    "WorkspaceState": {
      "title": "WorkspaceState",
      "description": "Real-time trading desk state, portfolios, cycle days, and trade journal for an authenticated user",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payloadJson": {
          "type": "string",
          "description": "Serialized JSON or GZB64-compressed string of the complete TallyNX workspace state (max 900,000 bytes)",
          "minLength": 2,
          "maxLength": 900000
        },
        "tradeCount": {
          "type": "number",
          "description": "Total number of trades recorded in the journal"
        },
        "portCount": {
          "type": "number",
          "description": "Total number of trading accounts/portfolios"
        },
        "clientUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp of the latest local mutation",
          "minLength": 10,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of document creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update"
        }
      },
      "required": ["ownerId", "payloadJson", "tradeCount", "portCount", "clientUpdatedAt", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized platform administrator record managed by bootstrapped custom-claim admins",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "LicenseKey": {
      "title": "LicenseKey",
      "description": "Commercial product license key redeemable by verified customers",
      "type": "object",
      "properties": {
        "licenseKey": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "plan": {
          "type": "string",
          "enum": ["TRIAL", "PRO", "LIFETIME"]
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "REVOKED"]
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "redeemedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "redeemedEmail": {
          "type": "string",
          "maxLength": 200
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["licenseKey", "plan", "status", "notes", "redeemedByUid", "redeemedEmail", "createdByUid", "createdAt", "updatedAt"]
    },
    "UserEntitlement": {
      "title": "UserEntitlement",
      "description": "Verified customer commercial subscription or license entitlement",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "plan": {
          "type": "string",
          "enum": ["FREE", "TRIAL", "PRO", "LIFETIME", "ADMIN"]
        },
        "licenseKey": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "SUSPENDED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "plan", "licenseKey", "status", "createdAt", "updatedAt"]
    },
    "PilotAllowlist": {
      "title": "PilotAllowlist",
      "description": "Admin-managed FundedNext MCP pilot cohort allowlist entry",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "email": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "FundedNextConnection": {
      "title": "FundedNextConnection",
      "description": "Server-managed FundedNext MCP broker connection metadata (client read-only)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "generation": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["CONNECTED", "DEGRADED", "RECONNECT_REQUIRED", "DISCONNECTED"]
        },
        "connectedAt": { "type": "number" },
        "blockedReason": { "type": ["string", "null"] },
        "statusJobId": { "type": ["string", "null"] }
      },
      "required": ["id", "ownerUid", "generation", "status"]
    },
    "FundedNextCredential": {
      "title": "FundedNextCredential",
      "description": "Encrypted OAuth/KMS credential envelope for FundedNext MCP (100% locked from clients)",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "connectionId": { "type": "string" },
        "generation": { "type": "number" },
        "envelope": { "type": "object" }
      },
      "required": ["ownerUid", "connectionId", "generation", "envelope"]
    },
    "FundedNextAccountSnapshot": {
      "title": "FundedNextAccountSnapshot",
      "description": "Server-managed FundedNext account metadata and live balance/equity snapshot (client read-only)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "connectionId": { "type": "string" },
        "tracked": { "type": "boolean" },
        "snapshot": { "type": "object" },
        "lastCheckedAt": { "type": "string" }
      },
      "required": ["id", "accountId", "ownerUid", "connectionId", "tracked"]
    },
    "FundedNextTradeExecution": {
      "title": "FundedNextTradeExecution",
      "description": "Server-managed immutable FundedNext broker execution/cashflow record (client read-only)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "accountRef": { "type": "string" },
        "connectionId": { "type": "string" },
        "dealId": { "type": "string" },
        "cycleId": { "type": ["string", "null"] },
        "kind": { "type": "string" }
      },
      "required": ["id", "ownerUid", "accountRef", "connectionId"]
    },
    "FundedNextJournalAnnotation": {
      "title": "FundedNextJournalAnnotation",
      "description": "Owner-only discretionary notes, tags, and execution linkage metadata",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "maxLength": 5000
        },
        "executionKey": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "accountId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "tags": {
          "type": ["array", "null"],
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "legacyUnlinked": {
          "type": ["boolean", "null"]
        },
        "importId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "note", "createdAt", "updatedAt"]
    },
    "FundedNextSyncJob": {
      "title": "FundedNextSyncJob",
      "description": "Server/worker leased sync job queue and cursors (100% locked from clients)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "connectionId": { "type": "string" },
        "connectionKey": { "type": "string" },
        "generation": { "type": "number" },
        "accountRef": { "type": ["string", "null"] },
        "type": {
          "type": "string",
          "enum": ["SNAPSHOT", "INITIAL_DISCOVERY", "BACKFILL_PAGE", "INCREMENTAL"]
        },
        "status": {
          "type": "string",
          "enum": ["QUEUED", "LEASED", "COMPLETE", "CANCELLED", "PARTIAL"]
        }
      },
      "required": ["id", "uid", "connectionId", "generation", "type", "status"]
    }
  },
  "firestore": {
    "/workspaces/{userId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceState"
      },
      "description": "Stores the primary real-time trading workspace and journal for each user"
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Stores platform administrator allowlist entries"
    },
    "/licenses/{licenseKey}": {
      "schema": {
        "$ref": "#/entities/LicenseKey"
      },
      "description": "Stores purchasable customer license keys and claim status"
    },
    "/entitlements/{userId}": {
      "schema": {
        "$ref": "#/entities/UserEntitlement"
      },
      "description": "Stores active plan entitlement and linked license key per user"
    },
    "/pilot_allowlist/{uid}": {
      "schema": {
        "$ref": "#/entities/PilotAllowlist"
      },
      "description": "Stores FundedNext pilot allowlist eligibility per UID"
    },
    "/fundednext_connections/{connectionId}": {
      "schema": {
        "$ref": "#/entities/FundedNextConnection"
      },
      "description": "Stores server-managed FundedNext MCP connection metadata"
    },
    "/fundednext_credentials/{connectionId}": {
      "schema": {
        "$ref": "#/entities/FundedNextCredential"
      },
      "description": "Stores encrypted FundedNext OAuth/KMS credential envelopes (server-only)"
    },
    "/account_snapshots/{accountId}": {
      "schema": {
        "$ref": "#/entities/FundedNextAccountSnapshot"
      },
      "description": "Stores FundedNext synced accounts and latest balance/equity snapshots"
    },
    "/trade_executions/{accountId}/items/{executionKey}": {
      "schema": {
        "$ref": "#/entities/FundedNextTradeExecution"
      },
      "description": "Stores FundedNext immutable broker trade executions and cashflows"
    },
    "/journal_annotations/{uid}/entries/{annotationId}": {
      "schema": {
        "$ref": "#/entities/FundedNextJournalAnnotation"
      },
      "description": "Stores owner-only discretionary journal notes, tags, and execution links"
    },
    "/sync_jobs/{jobId}": {
      "schema": {
        "$ref": "#/entities/FundedNextSyncJob"
      },
      "description": "Stores leased background sync jobs and pagination cursors (server-only)"
    }
  }
}

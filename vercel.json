{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in dependabot/*) exit 0;; esac; exit 1",
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "api/index.ts": {
      "includeFiles": "{firebase-applet-config.json,scripts/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    {
      "source": "/((?!api(?:/|$)|_vercel/|assets/|scripts/|manifest\\.webmanifest$|sw\\.js$|registerSW\\.js$|workbox-|favicon|icon\\.svg$|apple-touch-icon\\.png$|pwa-).*)",
      "destination": "/index.html"
    }
  ]
}

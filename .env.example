# ==============================================================================
# Tredyn Desk — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development and fill in your values.
# NEVER commit `.env` or `.env.local` with real credentials.
# ==============================================================================

# --- Core Server & Build ------------------------------------------------------
NODE_ENV="development"
PORT="3000"
# Set to "true" to disable Vite HMR / file watching in constrained environments
DISABLE_HMR="false"

# --- Frontend (Vite public variables — exposed to browser bundle) -------------
# Marketing/portal URL linked from Desk navigation
VITE_TREDYN_WEB_URL="https://tallynx.com/"
# Optional comma-separated bootstrap admin emails (prefer Firebase Custom Claims / Firestore /admins/{uid})
VITE_BOOTSTRAP_ADMIN_EMAILS=""

# --- AI Risk Copilot (Google Gemini) ------------------------------------------
# Server-only Gemini key for verified Desk founders, admins, and active Lifetime accounts.
# Other Desk accounts and guests can connect a personal provider in Settings.
GEMINI_API_KEY="your_api_key_placeholder"
# Optional comma-separated platform AI allowlists. Emails must be Firebase-verified.
FOUNDER_EMAILS=""
FOUNDER_UIDS=""
ADMIN_EMAILS=""
BOOTSTRAP_ADMIN_EMAILS=""
# Optional public OAuth client and registered callback overrides.
OPENAI_CODEX_OAUTH_CLIENT_ID=""
OPENAI_CODEX_OAUTH_REDIRECT_URI="http://localhost:1455/auth/callback"
# DATABENTO_API_KEY is per-user BYOK in Settings. No shared Desk key is required.

# --- Firebase Authentication & Firestore --------------------------------------
# Optional server-side fallback if apiKey is omitted from firebase-applet-config.json
FIREBASE_WEB_API_KEY=""

# --- SSO & Community Mall Snapshot Signing ------------------------------------
# Shared HMAC secret (minimum 16 characters) for cross-app SSO and Mall snapshots
TALLYNX_SSO_SECRET="placeholder_min_16_chars_sso_secret"
# Optional dedicated HMAC secret (>= 16 chars) for Mall snapshot signing (falls back to TALLYNX_SSO_SECRET)
TALLYNX_MALL_SNAPSHOT_SECRET=""
# Optional legacy fallback alias for TALLYNX_SSO_SECRET
SSO_SHARED_SECRET=""

# --- Sovereign MT5 Bridge & VPS Proxy (server.ts) -----------------------------
# Base HTTPS URL of your self-hosted MT5 bridge / VPS gateway (no trailing slash)
MT5_SOVEREIGN_BASE_URL="https://mt5-bridge.example.com"
# Optional override for FundedNext VPS proxy (defaults to MT5_SOVEREIGN_BASE_URL)
FUNDEDNEXT_VPS_BASE_URL=""
FUNDEDNEXT_GATEWAY_URL=""
# Shared HMAC secret (>= 32 chars) authenticating Vercel API <-> VPS RPC worker
FUNDEDNEXT_VPS_RPC_SECRET="placeholder_min_32_chars_vps_rpc_hmac_secret"

# --- FundedNext OAuth PKCE & Credential Envelope (Optional Pilot) -------------
# 64-char hex string (32 bytes) for local AES-256-GCM envelope encryption
FUNDEDNEXT_MASTER_KEY=""
# Optional GCP Cloud KMS CryptoKey resource name (overrides local master key)
FUNDEDNEXT_KMS_KEY_NAME=""
# Optional FundedNext MCP & OAuth endpoint overrides
FUNDEDNEXT_MCP_URL=""
FUNDEDNEXT_OAUTH_RESOURCE=""
FUNDEDNEXT_OAUTH_AUTHORIZE_ENDPOINT=""
FUNDEDNEXT_OAUTH_TOKEN_ENDPOINT=""
FUNDEDNEXT_OAUTH_REGISTRATION_ENDPOINT=""
FUNDEDNEXT_OAUTH_CLIENT_ID=""
FUNDEDNEXT_OAUTH_CLIENT_SECRET=""
FUNDEDNEXT_OAUTH_REDIRECT_URI=""
# Optional comma-separated extra trusted Desk origins for dynamic FundedNext OAuth callback routing
FUNDEDNEXT_ALLOWED_ORIGINS=""
# Optional GCP Service Account JSON (single-line) for server-side Firestore/KMS
FUNDEDNEXT_GOOGLE_SERVICE_ACCOUNT_JSON=""
FUNDEDNEXT_FIRESTORE_PROJECT_ID=""
GOOGLE_CLOUD_PROJECT=""
FUNDEDNEXT_FIRESTORE_DATABASE_ID=""

# --- FundedNext Pilot Worker (worker/index.ts) --------------------------------
# Comma-separated Firebase UIDs authorized for pilot sync worker
FUNDEDNEXT_ALLOWLIST_UIDS=""
# Path to local SQLite state file used by worker/index.ts (default: ./pilot.db)
FUNDEDNEXT_SQLITE_PATH="./pilot.db"

# --- Optional Self-Hosted Python MT5 Gateway (scripts/*_gateway.py) -----------
BIND_HOST="127.0.0.1"
BRIDGE_TOKEN=""
GATEWAY_TOKEN=""
FUNDEDNEXT_HUB_HOST="127.0.0.1"
FUNDEDNEXT_HUB_PORT="8766"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
MT5_PATH=""
WINEPREFIX=""
XVFB_DISPLAY=":99"
